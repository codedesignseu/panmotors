<?xml version="1.0"?>
<ruleset name="Pan Motors">
	<description>WordPress Coding Standards for the Pan Motors theme. Development only: run from dev/ with composer lint.</description>

	<file>..</file>
	<exclude-pattern>*/_design/*</exclude-pattern>
	<exclude-pattern>*/dev/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value=".."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="panmotors"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="panmotors"/>
			</property>
		</properties>
	</rule>
</ruleset>
